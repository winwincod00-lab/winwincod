// PROPOSAL ONLY: not generated, migrated or used by the application.
generator client {
  provider = "prisma-client-js"
  output = "./generated-do-not-use"
}

datasource db {
  provider     = "postgresql"
  url          = env("WINWINCOD_INTEGRITY_STAGING_URL")
  directUrl    = env("WINWINCOD_INTEGRITY_STAGING_DIRECT_URL")
  relationMode = "prisma"
}

// ====== Models ======

model user {
  id            String    @id @default(uuid())
  seqId         Int?
  name          String
  email         String    @unique(map: "User_email_key")
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          user_role @default(SELLER)
  isActive      Boolean   @default(true)
  bankName        String?
  bankAccountName String?
  rib             String?
  city            String?
  storeName       String?
  storeDescription String?
  storeLink        String?
  hasCompletedOnboarding Boolean @default(false)
  createdAt DateTime  @default(now())

  // Relations
  accounts      Account[]
  sessions      Session[]
  savedProducts SellerProduct[]
  wallet       wallet?
  logs         log[]
  orders       order[]      @relation("SellerOrders")
  orderBatches orderbatch[]
  deposits          depositrequest[]
  withdrawals       withdrawalrequest[]
  notifications     Notification[]
  back_fi_operation_seller_fk FiOperation[] @relation("fi_operation_seller_fk")
  back_fi_ledger_account_seller_fk FiLedgerAccount[] @relation("fi_ledger_account_seller_fk")
  back_fi_wallet_seller_fk FiWallet[] @relation("fi_wallet_seller_fk")
  back_fi_withdrawal_hold_seller_fk FiWithdrawalHold[] @relation("fi_withdrawal_hold_seller_fk")
  back_fi_funding_claim_seller_fk FiFundingClaim[] @relation("fi_funding_claim_seller_fk")
  back_fi_journal_seller_fk FiJournal[] @relation("fi_journal_seller_fk")
  back_fi_posting_seller_fk FiPosting[] @relation("fi_posting_seller_fk")
  back_fi_wallet_event_seller_fk FiWalletEvent[] @relation("fi_wallet_event_seller_fk")
  back_fi_order_line_seller_fk FiOrderLine[] @relation("fi_order_line_seller_fk")
  back_fi_cost_snapshot_seller_fk FiCostSnapshot[] @relation("fi_cost_snapshot_seller_fk")
  back_fi_cost_recognition_seller_fk FiCostRecognition[] @relation("fi_cost_recognition_seller_fk")
  back_fi_stock_operation_seller_fk FiStockOperation[] @relation("fi_stock_operation_seller_fk")
  back_fi_reservation_seller_fk FiReservation[] @relation("fi_reservation_seller_fk")
  back_fi_shipment_seller_fk FiShipment[] @relation("fi_shipment_seller_fk")
  back_fi_shipment_item_seller_fk FiShipmentItem[] @relation("fi_shipment_item_seller_fk")
  back_fi_return_receipt_seller_fk FiReturnReceipt[] @relation("fi_return_receipt_seller_fk")
  back_fi_disposition_seller_fk FiDisposition[] @relation("fi_disposition_seller_fk")
  back_fi_stock_movement_seller_fk FiStockMovement[] @relation("fi_stock_movement_seller_fk")
  back_fi_settlement_match_seller_fk FiSettlementMatch[] @relation("fi_settlement_match_seller_fk")
  back_fi_payout_intent_seller_fk FiPayoutIntent[] @relation("fi_payout_intent_seller_fk")
  back_fi_payout_evidence_seller_fk FiPayoutEvidence[] @relation("fi_payout_evidence_seller_fk")
  back_fi_settlement_link_seller_fk FiSettlementLink[] @relation("fi_settlement_link_seller_fk")
  back_fi_wallet_entitlement_seller_fk FiWalletEntitlement[] @relation("fi_wallet_entitlement_seller_fk")
  back_fi_line_charge_seller_fk FiLineCharge[] @relation("fi_line_charge_seller_fk")
  back_fi_shipment_terms_seller_fk FiShipmentTerms[] @relation("fi_shipment_terms_seller_fk")
  back_FiOpeningEvidence_approvedBy_fk FiOpeningEvidence[] @relation("FiOpeningEvidence_approvedBy_fk")
  back_FiOperation_actorId_fk FiOperation[] @relation("FiOperation_actorId_fk")
  back_FiWarehouseGrant_actorId_fk FiWarehouseGrant[] @relation("FiWarehouseGrant_actorId_fk")
  back_FiWarehouseGrant_approvedBy_fk FiWarehouseGrant[] @relation("FiWarehouseGrant_approvedBy_fk")
  back_FiGrantRevocation_actorId_fk FiGrantRevocation[] @relation("FiGrantRevocation_actorId_fk")
  back_FiStockOperation_actorId_fk FiStockOperation[] @relation("FiStockOperation_actorId_fk")
  back_FiFundingEvidence_verifiedBy_fk FiFundingEvidence[] @relation("FiFundingEvidence_verifiedBy_fk")
  back_FiRemittance_verifiedBy_fk FiRemittance[] @relation("FiRemittance_verifiedBy_fk")
  back_fi_payout_evidence_actor_fk FiPayoutEvidence[] @relation("fi_payout_evidence_actor_fk")
  back_fi_policy_owner_fk FiPolicyDecision[] @relation("fi_policy_owner_fk")
  back_fi_policy_revoke_actor_fk FiPolicyRevocation[] @relation("fi_policy_revoke_actor_fk")
  back_fi_entitlement_actor_fk FiWalletEntitlement[] @relation("fi_entitlement_actor_fk")
}

model wallet {
  id      String  @id @default(uuid())
  userId  String  @unique(map: "Wallet_userId_key")
  balance Decimal @default(0.0)

  // Relations
  user         user          @relation(fields: [userId], references: [id])
  transactions transaction[]
  back_fi_wallet_legacy_fk FiWallet[] @relation("fi_wallet_legacy_fk")
}

model transaction {
  id          String           @id @default(uuid())
  walletId    String
  amount      Decimal
  type        transaction_type
  referenceId String?
  description String?
  createdAt   DateTime         @default(now())

  wallet wallet @relation(fields: [walletId], references: [id])

  @@index([walletId], map: "Transaction_walletId_idx")
}

model log {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  user user @relation(fields: [userId], references: [id])

  @@index([userId], map: "Log_userId_idx")
}

model order {
  id             String       @id @default(uuid())
  seqId          Int?
  sellerId       String
  
  // 1. الربط مع الدفعة (Batch)
  batchId        String?
  batch          orderbatch?  @relation(fields: [batchId], references: [id])

  // 2. الربط مع المنتج (Product)
  productId      String?
  product        product?     @relation(fields: [productId], references: [id])

  customerName   String
  customerPhone  String
  address        String
  city           String
  productName    String
  quantity       Int
  codAmount      Decimal
  codReceived    Decimal?
  shippingFee    Decimal      @default(0.0)
  systemFee      Decimal      @default(0.0)
  netProfit      Decimal      @default(0.0)
  status         order_status @default(DRAFT)
  statusHistory  OrderStatusHistory[]
  trackingNumber String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  seller user @relation("SellerOrders", fields: [sellerId], references: [id])

  @@index([batchId], map: "Order_batchId_idx")
  @@index([sellerId], map: "Order_sellerId_idx")
  @@index([productId], map: "Order_productId_idx")
  back_fi_line_legacy_fk FiOrderLine[] @relation("fi_line_legacy_fk")
}

model orderbatch {
  id           String   @id @default(uuid())
  sellerId     String
  totalAmount  Decimal
  paymentProof String?
  isPaid       Boolean  @default(false)
  createdAt    DateTime @default(now())

  orders       order[]

  seller user @relation(fields: [sellerId], references: [id])

  @@index([sellerId], map: "OrderBatch_sellerId_idx")
}

model SellerProduct {
  id        String   @id @default(cuid())
  sellerId  String
  productId String
  addedAt   DateTime @default(now())

  seller    user     @relation(fields: [sellerId], references: [id])
  product   product  @relation(fields: [productId], references: [id])

  @@unique([sellerId, productId]) 
  @@index([sellerId])
}


model product {
  id          String   @id @default(uuid())
  seqId       Int?
  supplierId  String
  name        String
  description String?  @db.Text
  images      String   @db.Text
  sku         String   @unique(map: "Product_sku_key")
  costPrice   Decimal
  sellerPrice Decimal
  marketPrice Decimal
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  savedByUsers  SellerProduct[]
  orders      order[]

  supplier supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId], map: "Product_supplierId_idx")
  back_fi_line_product_fk FiOrderLine[] @relation("fi_line_product_fk")
  back_fi_stock_product_fk FiStockBalance[] @relation("fi_stock_product_fk")
}

model supplier {
  id          String  @id @default(uuid())
  name        String
  contactInfo String?

  products product[]
}

model depositrequest {
  id            String        @id @default(cuid())
  sellerId      String
  amount        Decimal
  receiptImage  String?       // رابط صورة الوصل
  status        deposit_status @default(PENDING)
  notes         String?    
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller        user          @relation(fields: [sellerId], references: [id])
  back_fi_claim_deposit_fk FiFundingClaim[] @relation("fi_claim_deposit_fk")
}

model OrderStatusHistory {
  id        String       @id @default(uuid())
  orderId   String
  status    order_status
  userId    String       // الشخص الذي غير الحالة
  createdAt DateTime     @default(now())

  order order @relation(fields: [orderId], references: [id])

  @@index([orderId], map: "OrderStatusHistory_orderId_idx")
}

model withdrawalrequest {
  id            String            @id @default(cuid())
  sellerId      String
  amount        Decimal
  receiptImage  String?       // رابط الوصل المرفق من المشرف عند الدفع
  status        withdrawal_status @default(PENDING)
  notes         String?    
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  seller        user              @relation(fields: [sellerId], references: [id])
  back_fi_hold_request_fk FiWithdrawalHold[] @relation("fi_hold_request_fk")
}

model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      user              @relation(fields: [userId], references: [id])
  type      notification_type
  title     String
  message   String
  isRead    Boolean           @default(false)
  link      String?
  createdAt DateTime          @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ====== Enums ======
enum transaction_type {
  DEPOSIT
  ORDER_PAYMENT
  REFUND_RETURN
  WITHDRAWAL
  SHIPPING_PAYMENT
  DELIVERY_PROFIT
}

enum deposit_status {
  PENDING
  APPROVED
  REJECTED
}

enum withdrawal_status {
  PENDING
  APPROVED
  REJECTED
}

enum user_role {
  ADMIN
  SELLER
  CALL_CENTER
}

enum notification_type {
  ORDER_STATUS
  DEPOSIT_APPROVED
  DEPOSIT_REJECTED
  PROFIT_CREDITED
  WALLET_DEDUCTED
  NEW_ORDER
}

enum order_status {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  WAITING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model FiOpeningEvidence {
  id String @id
  entityKind String
  entityId String
  evidenceHash String
  approvedBy String
  approvedAt DateTime @db.Timestamptz(6) @default(now())
  rel_FiOpeningEvidence_approvedBy_fk user @relation("FiOpeningEvidence_approvedBy_fk", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_fi_account_opening_fk FiLedgerAccount[] @relation("fi_account_opening_fk")
  back_fi_wallet_opening_fk FiWallet[] @relation("fi_wallet_opening_fk")
  back_fi_stock_opening_fk FiStockBalance[] @relation("fi_stock_opening_fk")
  @@unique([entityKind, entityId], map: "fi_opening_evidence_u0")
  @@index([approvedBy], map: "fi_opening_evidence_i0")
  @@map("fi_opening_evidence")
}

model FiOperation {
  id String @id
  sellerId String
  kind String
  requestKey String
  businessKey String
  payloadHash String
  policyDecisionId String
  actorId String
  createdAt DateTime @db.Timestamptz(6) @default(now())
  rel_fi_operation_seller_fk user @relation("fi_operation_seller_fk", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_FiOperation_actorId_fk user @relation("FiOperation_actorId_fk", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_fi_hold_operation_fk FiWithdrawalHold[] @relation("fi_hold_operation_fk")
  back_fi_funding_operation_fk FiFundingClaim[] @relation("fi_funding_operation_fk")
  back_fi_journal_operation_fk FiJournal[] @relation("fi_journal_operation_fk")
  back_fi_event_operation_fk FiWalletEvent[] @relation("fi_event_operation_fk")
  back_fi_line_operation_fk FiOrderLine[] @relation("fi_line_operation_fk")
  back_fi_snapshot_operation_fk FiCostSnapshot[] @relation("fi_snapshot_operation_fk")
  back_fi_recognition_operation_fk FiCostRecognition[] @relation("fi_recognition_operation_fk")
  back_fi_stock_financial_fk FiStockOperation[] @relation("fi_stock_financial_fk")
  back_fi_match_operation_fk FiSettlementMatch[] @relation("fi_match_operation_fk")
  back_fi_allocation_operation_fk FiRemittanceAllocation[] @relation("fi_allocation_operation_fk")
  back_fi_payout_operation_fk FiPayoutIntent[] @relation("fi_payout_operation_fk")
  back_fi_payout_event_operation_fk FiPayoutEvent[] @relation("fi_payout_event_operation_fk")
  back_fi_match_revoke_operation_fk FiMatchRevocation[] @relation("fi_match_revoke_operation_fk")
  back_fi_operation_receipt_fk FiOperationReceipt[] @relation("fi_operation_receipt_fk")
  rel_fi_operation_policy_fk FiPolicyDecision @relation("fi_operation_policy_fk", fields: [policyDecisionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_fi_entitlement_operation_fk FiWalletEntitlement[] @relation("fi_entitlement_operation_fk")
  back_fi_charge_operation_fk FiLineCharge[] @relation("fi_charge_operation_fk")
  back_fi_terms_operation_fk FiShipmentTerms[] @relation("fi_terms_operation_fk")
  @@unique([id, sellerId], map: "fi_operation_u0")
  @@unique([sellerId, kind, requestKey], map: "fi_operation_u1")
  @@unique([sellerId, kind, businessKey], map: "fi_operation_u2")
  @@index([actorId, createdAt], map: "fi_operation_i0")
  @@index([sellerId], map: "fi_operation_i1")
  @@index([actorId], map: "fi_operation_i2")
  @@index([policyDecisionId], map: "fi_operation_i3")
  @@map("fi_operation")
}

model FiLedgerAccount {
  id String @id
  sellerId String?
  kind String
  code String
  currency String
  openingDebitBalance Decimal @db.Decimal(65,30)
  openingEvidenceId String
  rel_fi_ledger_account_seller_fk user? @relation("fi_ledger_account_seller_fk", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_account_opening_fk FiOpeningEvidence @relation("fi_account_opening_fk", fields: [openingEvidenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_fi_wallet_account_fk FiWallet[] @relation("fi_wallet_account_fk")
  back_fi_posting_account_fk FiPosting[] @relation("fi_posting_account_fk")
  @@unique([code], map: "fi_ledger_account_u0")
  @@unique([id, sellerId], map: "fi_ledger_account_u1")
  @@index([sellerId], map: "fi_ledger_account_i0")
  @@index([openingEvidenceId], map: "fi_ledger_account_i1")
  @@map("fi_ledger_account")
}

model FiWallet {
  id String @id
  sellerId String
  legacyWalletId String
  ledgerAccountId String
  openingBalance Decimal @db.Decimal(65,30)
  balance Decimal @db.Decimal(65,30)
  held Decimal @db.Decimal(65,30)
  openingEvidenceId String
  activatedAt DateTime? @db.Timestamptz(6)
  rel_fi_wallet_seller_fk user @relation("fi_wallet_seller_fk", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_wallet_opening_fk FiOpeningEvidence @relation("fi_wallet_opening_fk", fields: [openingEvidenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_wallet_legacy_fk wallet @relation("fi_wallet_legacy_fk", fields: [legacyWalletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_wallet_account_fk FiLedgerAccount @relation("fi_wallet_account_fk", fields: [ledgerAccountId, sellerId], references: [id, sellerId], onDelete: Restrict, onUpdate: Restrict)
  back_fi_hold_wallet_fk FiWithdrawalHold[] @relation("fi_hold_wallet_fk")
  back_fi_event_wallet_fk FiWalletEvent[] @relation("fi_event_wallet_fk")
  @@unique([id, sellerId], map: "fi_wallet_u0")
  @@unique([sellerId], map: "fi_wallet_u1")
  @@unique([legacyWalletId], map: "fi_wallet_u2")
  @@unique([ledgerAccountId], map: "fi_wallet_u3")
  @@unique([openingEvidenceId], map: "fi_wallet_u4")

  @@map("fi_wallet")
}

model FiWithdrawalHold {
  id String @id
  sellerId String
  walletId String
  legacyRequestId String
  amount Decimal @db.Decimal(65,30)
  remaining Decimal @db.Decimal(65,30)
  state String
  payoutSnapshot String
  createdOperationId String
  rel_fi_withdrawal_hold_seller_fk user @relation("fi_withdrawal_hold_seller_fk", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_hold_wallet_fk FiWallet @relation("fi_hold_wallet_fk", fields: [walletId, sellerId], references: [id, sellerId], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_hold_operation_fk FiOperation @relation("fi_hold_operation_fk", fields: [createdOperationId, sellerId], references: [id, sellerId], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_hold_request_fk withdrawalrequest @relation("fi_hold_request_fk", fields: [legacyRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_fi_event_hold_fk FiWalletEvent[] @relation("fi_event_hold_fk")
  back_fi_payout_hold_fk FiPayoutIntent[] @relation("fi_payout_hold_fk")
  back_fi_payout_evidence_hold_fk FiPayoutEvidence[] @relation("fi_payout_evidence_hold_fk")
  @@unique([id, sellerId], map: "fi_withdrawal_hold_u0")
  @@unique([legacyRequestId], map: "fi_withdrawal_hold_u1")
  @@unique([createdOperationId], map: "fi_withdrawal_hold_u2")
  @@index([walletId, state], map: "fi_withdrawal_hold_i0")
  @@index([sellerId], map: "fi_withdrawal_hold_i1")
  @@index([walletId, sellerId], map: "fi_withdrawal_hold_i2")
  @@map("fi_withdrawal_hold")
}

model FiFundingEvidence {
  id String @id
  sourceAccountRef String
  externalRef String
  amount Decimal @db.Decimal(65,30)
  currency String
  evidenceHash String
  verifiedBy String
  verifiedAt DateTime @db.Timestamptz(6) @default(now())
  rel_FiFundingEvidence_verifiedBy_fk user @relation("FiFundingEvidence_verifiedBy_fk", fields: [verifiedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  back_fi_claim_evidence_fk FiFundingClaim[] @relation("fi_claim_evidence_fk")
  @@unique([sourceAccountRef, externalRef], map: "fi_funding_evidence_u0")
  @@index([verifiedBy], map: "fi_funding_evidence_i0")
  @@map("fi_funding_evidence")
}

model FiFundingClaim {
  id String @id
  sellerId String
  operationId String
  evidenceId String
  legacyDepositId String?
  rel_fi_funding_claim_seller_fk user @relation("fi_funding_claim_seller_fk", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_funding_operation_fk FiOperation @relation("fi_funding_operation_fk", fields: [operationId, sellerId], references: [id, sellerId], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_claim_evidence_fk FiFundingEvidence @relation("fi_claim_evidence_fk", fields: [evidenceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_claim_deposit_fk depositrequest? @relation("fi_claim_deposit_fk", fields: [legacyDepositId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([operationId], map: "fi_funding_claim_u0")
  @@unique([evidenceId], map: "fi_funding_claim_u1")
  @@unique([legacyDepositId], map: "fi_funding_claim_u2")
  @@index([sellerId], map: "fi_funding_claim_i0")
  @@map("fi_funding_claim")
}

model FiJournal {
  id String @id
  sellerId String
  operationId String
  settlementMatchId String?
  currency String
  createdAt DateTime @db.Timestamptz(6) @default(now())
  rel_fi_journal_seller_fk user @relation("fi_journal_seller_fk", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_journal_operation_fk FiOperation @relation("fi_journal_operation_fk", fields: [operationId, sellerId], references: [id, sellerId], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_journal_match_fk FiSettlementMatch? @relation("fi_journal_match_fk", fields: [settlementMatchId, sellerId], references: [id, sellerId], onDelete: Restrict, onUpdate: Restrict)
  back_fi_posting_journal_fk FiPosting[] @relation("fi_posting_journal_fk")
  back_fi_event_journal_fk FiWalletEvent[] @relation("fi_event_journal_fk")
  @@unique([id, sellerId], map: "fi_journal_u0")
  @@unique([operationId], map: "fi_journal_u1")
  @@unique([settlementMatchId], map: "fi_journal_u2")
  @@index([sellerId], map: "fi_journal_i0")
  @@map("fi_journal")
}

model FiPosting {
  id String @id
  sellerId String
  journalId String
  accountId String
  amount Decimal @db.Decimal(65,30)
  reversalOfId String?
  rel_fi_posting_seller_fk user @relation("fi_posting_seller_fk", fields: [sellerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_posting_journal_fk FiJournal @relation("fi_posting_journal_fk", fields: [journalId, sellerId], references: [id, sellerId], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_posting_account_fk FiLedgerAccount @relation("fi_posting_account_fk", fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  rel_fi_posting_reversal_fk FiPosting? @relation("fi_posting_reversal_fk", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: Restrict)
